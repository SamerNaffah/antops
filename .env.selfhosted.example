# =============================================================================
# Antops — Self-hosted configuration
# =============================================================================
# This file is used when you run Antops with the bundled `docker-compose.yml`:
# Postgres + MinIO + Redis + the app, all on a single host, no external SaaS
# required.
#
# If you prefer the hosted-Supabase path, copy `antops-app/.env.example` to
# `antops-app/.env.local` instead.
#
# Quick start:
#   cp .env.selfhosted.example .env
#   # edit the values below, then:
#   make up
# =============================================================================


# -----------------------------------------------------------------------------
# Database (Postgres)
# -----------------------------------------------------------------------------
# These feed the `postgres` service and the app's DATABASE_URL.
POSTGRES_USER=antops
POSTGRES_DB=antops
POSTGRES_PASSWORD=replace-with-a-long-random-string

# The app picks this up directly; leave as-is unless you changed the service name.
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}


# -----------------------------------------------------------------------------
# Auth (NextAuth)
# -----------------------------------------------------------------------------
# Public URL you'll access the app on (used for OAuth callbacks, emails, etc.).
NEXTAUTH_URL=http://localhost:3000

# Generate with: `openssl rand -base64 32`
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32


# -----------------------------------------------------------------------------
# Object storage (MinIO — S3-compatible)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=antops
MINIO_ROOT_PASSWORD=replace-with-a-long-random-string


# -----------------------------------------------------------------------------
# Cache / sessions (Redis)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=replace-with-a-long-random-string


# -----------------------------------------------------------------------------
# AI (optional)
# -----------------------------------------------------------------------------
# If both are blank, AI features degrade gracefully and the app still boots.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=


# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
ENABLE_AI_FEATURES=true
ENABLE_INTEGRATIONS=true
